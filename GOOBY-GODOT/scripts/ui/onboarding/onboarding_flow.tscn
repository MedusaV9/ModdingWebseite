[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/onboarding/onboarding_flow.gd" id="1_flow"]
[ext_resource type="Script" path="res://scripts/ui/wallpaper.gd" id="2_wall"]
