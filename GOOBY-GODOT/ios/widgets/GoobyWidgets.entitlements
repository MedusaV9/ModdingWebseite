<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- GOOBY-WIDGETS: App-Group der Widget-Extension — MUSS identisch sein
	     mit GoobyKitConfig.appGroupId (GoobyKitShared.swift) und der App-
	     Entitlements-Datei (schreibt tools/ci/inject_widgets.rb). AltStore/
	     SideStore mappen die Gruppe beim Sideload auf die eigene Team-Id. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.permissionmaxed.gooby.shared</string>
	</array>
</dict>
</plist>
