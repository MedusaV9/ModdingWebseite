{
  "id": "counter-strike-source",
  "name": "Counter-Strike: Source",
  "category": "shooter",
  "description": "The Source engine classic. SRCDS dedicated server installed via SteamCMD (anonymous).",
  "icon": "crosshair",
  "color": "#eab308",
  "platforms": ["linux", "win32"],
  "install": [
    { "type": "steamcmd", "appId": 232330, "validate": true },
    { "type": "writeFile", "path": "cstrike/cfg/server.cfg", "content": "hostname \"{{HOSTNAME}}\"\nsv_region 255\nmp_timelimit 30\n" }
  ],
  "startCommand": "./srcds_run -game cstrike -port {{SERVER_PORT}} +map {{MAP}} +maxplayers {{MAX_PLAYERS}} +rcon_password \"{{RCON_PASSWORD}}\"",
  "stop": { "type": "command", "command": "quit", "timeoutS": 30 },
  "variables": [
    { "key": "SERVER_PORT", "label": "Game port", "type": "number", "default": 27015, "min": 1024, "max": 65535, "isPort": true },
    { "key": "MAP", "label": "Start map", "description": "e.g. de_dust2, de_inferno, cs_office, de_aztec.", "type": "string", "default": "de_dust2", "required": true },
    { "key": "HOSTNAME", "label": "Server name", "type": "string", "default": "Between CS:S Server", "required": true },
    { "key": "MAX_PLAYERS", "label": "Max players", "type": "number", "default": 16, "min": 1, "max": 64 },
    { "key": "RCON_PASSWORD", "label": "RCON password", "description": "Enables console commands via Source RCON (on the game port) when set. Leave empty to disable RCON.", "type": "password", "default": "", "advanced": true }
  ],
  "ports": [{ "name": "game", "variable": "SERVER_PORT", "protocol": "both" }],
  "query": { "type": "source", "portVariable": "SERVER_PORT" },
  "rcon": { "portVariable": "SERVER_PORT", "passwordVariable": "RCON_PASSWORD" },
  "playerActions": [{ "key": "kick", "label": "Kick", "command": "kick {{PLAYER}}" }],
  "configFiles": [{ "path": "cstrike/cfg/server.cfg", "format": "keyvalue", "mappings": { "HOSTNAME": "hostname" } }],
  "backupExcludes": ["steamapps/**", "cstrike/download/**"],
  "notes": "Server config lives in cstrike/cfg/server.cfg. A GSLT from steamcommunity.com/dev/managegameservers (app 240) is recommended for public servers: +sv_setsteamaccount <token>. Windows hosts: set the start command override to srcds.exe -game cstrike with the same arguments.",
  "version": "1"
}
