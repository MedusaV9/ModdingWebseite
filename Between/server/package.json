{
  "name": "@between/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test --test-concurrency=1 --test-reporter=spec \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-blueprints.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.20.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "typescript": "~6.0.2"
  }
}
