{
  "id": "mordhau",
  "name": "Mordhau",
  "category": "shooter",
  "description": "Skill-based medieval melee combat for up to 64 players. Dedicated server installed via SteamCMD (anonymous).",
  "icon": "swords",
  "color": "#92400e",
  "platforms": ["linux", "win32"],
  "install": [{ "type": "steamcmd", "appId": 629800, "validate": true }],
  "startCommand": "./MordhauServer.sh -Port={{SERVER_PORT}} -QueryPort={{QUERY_PORT}} -BeaconPort={{BEACON_PORT}}",
  "stop": { "type": "signal", "signal": "SIGTERM", "timeoutS": 30 },
  "variables": [
    { "key": "SERVER_PORT", "label": "Game port (UDP)", "type": "number", "default": 7777, "min": 1024, "max": 65535, "isPort": true },
    { "key": "QUERY_PORT", "label": "Query port (UDP)", "type": "number", "default": 27015, "min": 1024, "max": 65535, "isPort": true },
    { "key": "BEACON_PORT", "label": "Beacon port (UDP)", "type": "number", "default": 15000, "min": 1024, "max": 65535, "isPort": true, "advanced": true }
  ],
  "ports": [
    { "name": "game", "variable": "SERVER_PORT", "protocol": "udp" },
    { "name": "query", "variable": "QUERY_PORT", "protocol": "udp" },
    { "name": "beacon", "variable": "BEACON_PORT", "protocol": "udp" }
  ],
  "query": { "type": "source", "portVariable": "QUERY_PORT" },
  "backupExcludes": ["steamapps/**"],
  "notes": "Server name, passwords, map rotation and admins are configured in Mordhau/Saved/Config/LinuxServer/Game.ini (WindowsServer on Windows), generated on first start. Windows hosts: set the start command override to MordhauServer.exe with the same arguments.",
  "version": "1"
}
