{
  "id": "hurtworld",
  "name": "Hurtworld",
  "category": "survival",
  "description": "Hardcore multiplayer survival FPS with vehicles and territory control. Dedicated server installed via SteamCMD (anonymous).",
  "icon": "tent",
  "color": "#ea580c",
  "platforms": ["linux", "win32"],
  "install": [{ "type": "steamcmd", "appId": 405100, "validate": true }],
  "startCommand": "./Hurtworld.x86_64 -batchmode -nographics -logfile /dev/stdout -exec \"host {{SERVER_PORT}};queryport {{QUERY_PORT}};servername {{HOSTNAME}};maxplayers {{MAX_PLAYERS}}\"",
  "stop": { "type": "signal", "signal": "SIGTERM", "timeoutS": 30 },
  "variables": [
    { "key": "HOSTNAME", "label": "Server name", "type": "string", "default": "Between Hurtworld Server", "required": true },
    { "key": "SERVER_PORT", "label": "Game port (UDP)", "type": "number", "default": 12871, "min": 1024, "max": 65535, "isPort": true },
    { "key": "QUERY_PORT", "label": "Query port (UDP)", "type": "number", "default": 12881, "min": 1024, "max": 65535, "isPort": true },
    { "key": "MAX_PLAYERS", "label": "Max players", "type": "number", "default": 40, "min": 1, "max": 100 }
  ],
  "ports": [
    { "name": "game", "variable": "SERVER_PORT", "protocol": "udp" },
    { "name": "query", "variable": "QUERY_PORT", "protocol": "udp" }
  ],
  "query": { "type": "source", "portVariable": "QUERY_PORT" },
  "backupExcludes": ["steamapps/**"],
  "notes": "Server commands are passed via the -exec string (semicolon-separated). Add admins with 'addadmin <SteamID64>' in the -exec string or the server console. Saves are written next to the binary. Windows hosts: set the start command override to Hurtworld.exe -batchmode -nographics -logfile output.log -exec \"...\" with the same commands.",
  "version": "1"
}
