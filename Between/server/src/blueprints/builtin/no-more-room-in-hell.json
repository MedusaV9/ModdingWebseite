{
  "id": "no-more-room-in-hell",
  "name": "No More Room in Hell",
  "category": "shooter",
  "description": "Free co-op zombie survival on the Source engine. SRCDS dedicated server installed via SteamCMD (anonymous).",
  "icon": "skull",
  "color": "#57534e",
  "platforms": ["linux", "win32"],
  "install": [
    { "type": "steamcmd", "appId": 317670, "validate": true },
    { "type": "writeFile", "path": "nmrih/cfg/server.cfg", "content": "hostname \"{{HOSTNAME}}\"\nsv_region 255\n" }
  ],
  "startCommand": "./srcds_run -game nmrih -port {{SERVER_PORT}} +map {{MAP}} +maxplayers {{MAX_PLAYERS}} +rcon_password \"{{RCON_PASSWORD}}\"",
  "stop": { "type": "command", "command": "quit", "timeoutS": 30 },
  "variables": [
    { "key": "SERVER_PORT", "label": "Game port", "type": "number", "default": 27015, "min": 1024, "max": 65535, "isPort": true },
    { "key": "MAP", "label": "Start map", "description": "Objective maps use the nmo_ prefix, survival maps nms_ (e.g. nmo_broadway, nms_northway).", "type": "string", "default": "nmo_broadway", "required": true },
    { "key": "HOSTNAME", "label": "Server name", "type": "string", "default": "Between NMRiH Server", "required": true },
    { "key": "MAX_PLAYERS", "label": "Max players", "type": "number", "default": 8, "min": 1, "max": 9 },
    { "key": "RCON_PASSWORD", "label": "RCON password", "description": "Enables console commands via Source RCON (on the game port) when set. Leave empty to disable RCON.", "type": "password", "default": "", "advanced": true }
  ],
  "ports": [{ "name": "game", "variable": "SERVER_PORT", "protocol": "both" }],
  "query": { "type": "source", "portVariable": "SERVER_PORT" },
  "rcon": { "portVariable": "SERVER_PORT", "passwordVariable": "RCON_PASSWORD" },
  "playerActions": [{ "key": "kick", "label": "Kick", "command": "kick {{PLAYER}}" }],
  "configFiles": [{ "path": "nmrih/cfg/server.cfg", "format": "keyvalue", "mappings": { "HOSTNAME": "hostname" } }],
  "backupExcludes": ["steamapps/**", "nmrih/download/**"],
  "notes": "The game and its server are free. Server config lives in nmrih/cfg/server.cfg. Windows hosts: set the start command override to srcds.exe -game nmrih with the same arguments.",
  "version": "1"
}
