{
  "name": "monkey-money",
  "version": "0.1.0",
  "private": true,
  "description": "MONKEY MONEY — Jackbox/Buzz-artige Quiz-Show-Party-App (Walking Skeleton)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/index.js",
    "start": "node server/dist/index.js",
    "bots": "tsx tools/bots/index.ts",
    "test": "vitest run",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "lit-html": "^3.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.5.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "ws": "^8.21.3"
  }
}
